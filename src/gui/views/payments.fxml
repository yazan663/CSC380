<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.controllers.PaymentController">

    <!-- Top Bar -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" left="10" right="10" bottom="10"/>
            </padding>
            <Button text="← Back" onAction="#backToMain"/>
            <Label text="Manage Payments">
                <style>
                    -fx-font-size: 18px;
                    -fx-font-weight: bold;
                </style>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" left="20" right="20" bottom="20"/>
            </padding>

            <!-- Form -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120"/>
                    <ColumnConstraints halignment="LEFT" minWidth="200"/>
                </columnConstraints>

                <children>
                    <Label text="Payment ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Payment Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtDate" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Amount:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtAmount" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Method:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtMethod" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Order ID:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtOrderId" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </children>
            </GridPane>

            <!-- CRUD Buttons -->
            <HBox spacing="10">
                <Button text="Add" onAction="#addPayment"/>
                <Button text="Find Payment" onAction="#findPayment"/>
                <Button text="Update Method" onAction="#updatePaymentMethod"/>
                <Button text="Delete" onAction="#deletePayment"/>
                <Button text="Clear" onAction="#clearForm"/>
            </HBox>

            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Search by:"/>
                <ComboBox fx:id="searchField"/>
                <TextField fx:id="searchValue" promptText="Enter value..."/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="paymentTable" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="colAmount" text="Amount" prefWidth="100"/>
                    <TableColumn fx:id="colMethod" text="Method" prefWidth="120"/>
                    <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="90"/>
                </columns>
            </TableView>

            <TextArea fx:id="txtMessages" editable="false" prefRowCount="3"/>

        </VBox>
    </center>

</BorderPane>
