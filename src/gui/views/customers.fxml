<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.controllers.CustomerController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" left="10" right="10" bottom="10"/>
            </padding>
            <Button text="← Back" onAction="#backToMain"/>
            <Label text="Manage Customers">
                <style>
                    -fx-font-size: 18px;
                    -fx-font-weight: bold;
                </style>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" left="20" right="20" bottom="20"/>
            </padding>

            <!-- Form -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                    <ColumnConstraints halignment="LEFT" minWidth="200"/>
                </columnConstraints>

                <children>
                    <Label text="Customer ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtName" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmail" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Phone:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPhone" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Address:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtAddress" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </children>
            </GridPane>

            <!-- Buttons -->
            <HBox spacing="10">
                <Button text="Add"          onAction="#addCustomer"/>
                <Button text="Find by ID"   onAction="#findCustomer"/>
                <Button text="Update Email" onAction="#updateCustomerEmail"/>
                <Button text="Delete"       onAction="#deleteCustomer"/>
                <Button text="Clear"        onAction="#clearForm"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="customerTable" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colId"      text="ID"      prefWidth="70"/>
                    <TableColumn fx:id="colName"    text="Name"    prefWidth="150"/>
                    <TableColumn fx:id="colEmail"   text="Email"   prefWidth="200"/>
                    <TableColumn fx:id="colPhone"   text="Phone"   prefWidth="120"/>
                    <TableColumn fx:id="colAddress" text="Address" prefWidth="150"/>
                </columns>
            </TableView>

            <TextArea fx:id="txtMessages" editable="false" prefRowCount="3"/>
        </VBox>
    </center>
</BorderPane>
